generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  login    String @unique
  password String
  role     String @default("owner")
}

model City {
  id      String   @id @default(cuid())
  name    String   @unique
  sellers Seller[]
  items   Item[]
}

model Seller {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  username  String?
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  ratesJson Json?
  createdAt DateTime @default(now())

  items     Item[]
  revisions Revision[]
}

model Item {
  id         String   @id @default(cuid())
  name       String
  price      Decimal  @db.Decimal(10, 2)
  cityId     String
  city       City     @relation(fields: [cityId], references: [id])
  sellerId   String?
  seller     Seller?  @relation(fields: [sellerId], references: [id])
  adminRate  Decimal? @db.Decimal(10, 2)
  category   String   @default("general")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  revisionItems RevisionItem[]
}

model Revision {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id])
  note      String?
  createdAt DateTime @default(now())

  items RevisionItem[]
}

model RevisionItem {
  id         String   @id @default(cuid())
  revisionId String
  revision   Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  expected   Int
  actual     Int
}
